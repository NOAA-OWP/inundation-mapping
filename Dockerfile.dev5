# RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
# echo "Stage 2: Starting Stage 2 GDAL and PROJ build: $(date)"

# Step 1: Use the official OSGeo GDAL base image
# FROM ghcr.io/osgeo/gdal:ubuntu-small-3.13.2 AS gdal_source

# ARG depDir=/dependencies
# ENV taudemDir=$depDir/taudem/bin
# ENV taudemDir2=$depDir/taudem_accelerated_flowDirections/taudem/build/bin


# COPY --from=taudem_builder $depDir $depDir
# RUN chown -R root:root $depDir && chmod -R 777 $depDir


###################
# Stage 3: Your actual application runtime environment
# FROM python:3.13-slim as base
FROM ghcr.io/osgeo/gdal:ubuntu-small-3.13.2


## ============================
# Grab the official 'uv' binary using a multi-stage copy
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1
ENV UV_PYTHON=/usr/bin/python3
ENV UV_SYSTEM_PYTHON=1

# 5. Native OSGeo/GDAL paths
ENV PROJ_DIR=/usr/local
ENV PROJ_LIB=/usr/local/share/proj

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    libspatialindex-dev \
    libnetcdf-dev \
    libhdf5-dev \
    time \
    parallel \
    htop \
    acl \
    p7zip-full \
    unzip \
    git \
    rsync \
    tzdata \
    wget \
    osmium-tool \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Copy GDAL configuration and binaries from the source stage
# COPY --from=gdal_source /usr/local/bin/ /usr/local/bin/
# COPY --from=gdal_source /usr/local/lib/ /usr/local/lib/
# COPY --from=gdal_source /usr/local/share/gdal/ /usr/local/share/gdal/
# COPY --from=gdal_source /usr/local/share/proj/ /usr/local/share/proj/

# Configure vital environment variables so system tools can find GDAL/PROJ
ENV GDAL_CONFIG=/usr/local/bin/gdal-config
# ENV GDAL_DATA=/usr/local/share/gdal
# ENV PROJ_DIR=/usr/local
# ENV PROJ_LIB=/usr/local/share/proj
#ENV LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH

# (Optional adjustment ONLY if geospatial packages fail to compile)

# ENV PACKAGE_DATA=1

# 2. Strict Single-Threading limits for internal libraries.
# This prevents thread-multiplication chaos when you spawn a Python ProcessPool 
# or run several GNU parallel jobs at once.
ENV OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    VECLIB_MAXIMUM_THREADS=1 \
    NUMBA_NUM_THREADS=1 \
    GDAL_NUM_THREADS=1

# ==============================================================================
# GDAL PERFORMANCE TUNING
# ==============================================================================
# 1. Prevent massive directory indexing slowdowns
ENV GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR

# 2. Expand internal GDAL RAM memory caching (Defaults to only 5% of RAM)
ENV GDAL_CACHEMAX=1024

# Enhanced settings for large multi-file mosaics
ENV GDAL_MAX_DATASET_POOL_SIZE=2000 \
    CPL_VSIL_CURL_ALLOWED_EXTENSIONS=".tif .tiff .vrt"


# ==============================================================================
# GPKG & GEOPARQUET VECTOR OPTIMIZATIONS
# ==============================================================================
# 1. Cache SQLite operations in RAM instead of thrashing the disk mount
ENV OGR_SQLITE_CACHE=512

# 2. Force SQLite/GPKG to commit in fast memory pools (safe for read-heavy Docker)
ENV OGR_SQLITE_SYNCHRONOUS=OFF

# 3. Stream only the required byte-ranges for GeoParquet files
ENV GDAL_HTTP_MERGE_CONSECUTIVE_RANGES=YES


###################

ARG dataDir=/data
ARG depDir=/dependencies

ENV projectDir=/foss_fim
ENV inputsDir=$dataDir/inputs
ENV outputsDir=/outputs
ENV srcDir=$projectDir/src
ENV toolsDir=$projectDir/tools
ENV workDir=/fim_temp
ENV taudemDir=$depDir/taudem/bin
ENV taudemDir2=$depDir/taudem_accelerated_flowDirections/taudem/build/bin

ENV LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    DEBIAN_FRONTEND=noninteractive \
    TZ=UTC

# Set system environment variables to prevent Python issues inside Docker
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

## ============================
RUN mkdir -p $workDir


# COPY --from=gdal_source $depDir $depDir
 #RUN chown -R root:root $depDir && chmod -R 777 $depDir



ENV PATH="${projectDir}:${PATH}"

## ADD TO PYTHON PATHS ##
ENV PYTHONPATH="${projectDir}:\
${srcDir}:\
${srcDir}/utils:\
${projectDir}/data:\
${toolsDir}"

## ADDING FIM GROUP ##
# ARG GroupID=1370800235
# ARG GroupName=fim
# RUN groupadd --gid $GroupID $GroupName
# ENV GID=$GroupID
# ENV GN=$GroupName


RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    echo "Stage 3: Apt downloads and setup: $(date)"

# ===========
# Set the working directory to your dynamic mount point
WORKDIR /foss_fim

# Step 4: Create the virtual environment and install requirements
# We copy requirements.txt to a temporary directory so it survives your volume mount
COPY requirements-313.txt ./requirements.txt


# 7. Install all dependencies using uv's persistent build cache
# --no-binary forces packages to build against the container's exact GDAL/PROJ binaries
# --no-build-isolation so uv can access system headers during compilation
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --break-system-packages -v -r requirements.txt

# Note: rasterio,fiona,pyogrio,pyproj are avaialble for use and are embedded from
# gdal 3.13 base image. They are compiled specifically to work with system level
# gdal 3.13.  Do not attempt to add them to the requirements.txt or upgrade them.


# NOTE: We do NOT use "COPY . ." here because your 'foss_fim' mount 
# handles injecting the code dynamically at runtime.

# Reset workspace context directly back to root for your entrypoint launcher context
# WORKDIR /

ADD ./src/entrypoint.sh /
ENTRYPOINT ["/bin/bash", "entrypoint.sh"]

# Set Bash as the fallback command. Since you run in interactive mode (-it),
# if your entrypoint exits or is overridden, you are cleanly dropped into the shell.
CMD ["/bin/bash"]
