# ==========================================
# Stage 1: Build Environment (Using OSGeo GDAL 3.12)
# ==========================================
FROM ghcr.io/osgeo/gdal:ubuntu-small-3.12.3 AS builder
RUN echo "++++++++++++++++++++++++++++++++++++++++++++++\n Stage 1: Starting TauDEM build: $(date)"

ENV DEBIAN_FRONTEND=noninteractive

# Install remaining system compilation prerequisites (GDAL is already baked in)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libmpich-dev \
    mpich \
    openmpi-bin \
    libopenmpi-dev \
    # gdal-bin \
    # libgdal-dev \
    # libproj-dev \
    libtiff-dev \
    libgeotiff-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install core build essentials, compression libraries, and MPICH
# RUN apt-get update && apt-get install -y --no-install-recommends \
#     build-essential \
#     cmake \
#     git \
#     libmpich-dev \
#     mpich \
#     ca-certificates \
#     libproj-dev \
#     libtiff-dev \
#     libgeotiff-dev \
#     wget \
#     && rm -rf /var/lib/apt/lists/*

