
# ###########################
# This can contain any variables for deployments, uploads, downloads, workflow automation values, etc

# AWS credentials should be kept in this file but its own aws_params_(type).env for security reasons.


# ****** BE SUPER CAREFUL especially with paths. ******

# Many tools such as deploy scripts will copy file up to s3 bucket and we want to be super careful
# to not overwrite data unless desired.

# In this doc, sets of both dev test paths and prod paths can be used.


# ****** ALSO SUPER IMPORTANT ******

# This file might be actively in use by multiple scripts at one time, especially when we get to automation.
# To dev test, make a copy of this, adjust, then feed the dev version into the script.

# =================================================================
# HYDROVIS DEPLOYMENT PARAMS

HV_S3_BUCKET_NAME = "not set"
FIM_S3_BUCKET_NAME = "fim-dev"

# You can also change these three values to help with test pathing of course if you like.
RELEASE_FIM_PUBLIC_VERSION = "test" # Change this to 6_1 is going into production in spring 2026.
HAND_VERSION = "4_9_9_0"
HAND_PREVIOUS_VERSION = "4_8_7_2"

# --- Test Target test paths
HV_S3_ROOT_HANDSET_PATH = "temp/RobH_2/hand_datasets"
HV_S3_ROOT_QA_DATASETS_PATH = "temp/RobH_2/qa_datasets/"

# --- Target Production Paths (needs adjustment for FIM 6.1 when we get there)
# HV_S3_ROOT_HANDSET_PATH = "/fim/{RELEASE_FIM_PUBLIC_VERSION}/hand_{HAND_VERSION}/hand_datasets"
# HV_S3_ROOT_QA_DATASETS_PATH = "/fim/{RELEASE_FIM_PUBLIC_VERSION}/hand_{HAND_VERSION}/qa_datasets"

# ---------------------------
# Source HAND dataset
# FIM_HAND_DATASET_LOCAL_PATH = "/data/previous_fim/hand_{HAND_VERSION}"
FIM_HAND_DATASET_LOCAL_PATH = "/data/outputs/Rob_deploy_test_10/"

# ---------------------------
# Source hand files from FIM to HV bucket
# These are python glob patterns to find file to load. They are concat to HV_HAND_LOCAL_PATH for full search paths.
# Critical to get the count right based on the num commands included.
# Note: "*/" means root HUC level.  If it has nothing in front of the file name, it is hand output level
HV_HAND_LOAD_PATTERN_1 = "*/hydrotable.parquet"
HV_HAND_LOAD_PATTERN_2 = "*/wbd.gpkg"
HV_HAND_LOAD_PATTERN_3 = "*/usgs_elev_table.csv"
HV_HAND_LOAD_PATTERN_4 = "*/osm_bridge_centroids.gpkg"
HV_HAND_LOAD_PATTERN_5 = "*/osm_roads_fimpact.csv"
HV_HAND_LOAD_PATTERN_6 = "*/osm_roads_subset.gpkg"
HV_HAND_LOAD_PATTERN_7 = "*/branches/*/gw_catchments_reaches_filtered_addedAttributes_*.tif"
HV_HAND_LOAD_PATTERN_8 = "*/branches/*/gw_catchments_reaches_filtered_addedAttributes_crosswalked_*.gpkg"
HV_HAND_LOAD_PATTERN_9 = "*/branches/*/rem_zeroed_masked_*.tif"
HV_HAND_LOAD_PATTERN_10 = "crosswalk_table.csv"
HV_HAND_LOAD_PATTERN_11 = "fim_inputs.csv"

