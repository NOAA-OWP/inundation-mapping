#!/bin/bash -e

# l_echo means log and echo to screen
# If the log_file_path does not exist, it will echo only
# Note: Generally, you do not need to use this if the .sh file calling it is already wrapped by
# another py file. All output and error text in many files are automatically caught and included in parent
# log files. ie) Using a l_echo anywhere in run_unit.sh, run_branch.sh, calibrate_rating_curves.sh has no value
# as standard "echo"s will auto be included in their parents .sh such as fim_process_huc.sh

# If you do in use l_echo in child .sh files such as mentioned above, you will only get duplicate entries
# in the final rollup log files.
l_echo () {
    local msg="$1"
    local log_file_path="$2"

    if [[ "$log_file_path" != "" ]]; then
        # if the file does not exist, we create an empty one via touch
        echo -e "${msg}" ; echo -e "${msg}" >> $log_file_path
    else
        echo -e "${msg}"
    fi
}

##########################
## Timing functions
T_total_start () {
    t0=`date +%s`
}

# NOTES ABOUT tstart and tcount
# You really only need to wrap subscript calls like py files if you know it is a long
# running script and you want to know how long it took to run, otherwise skip it.
# ie) 
#    tstart
#    python3 somefile.py
#    tcount
#
# If it is a script that runs pretty quickly ( < 5 mins ??), skip adding tstart and tcount.
# It just adds to the logs and has no value.
Tstart () {
    t1=`date +%s`
}

# This one is based on the value of t1 created earlier, and end is now
# Note, this can be deprecated in favour of Calc_Duration
# In the meantime, we will just pick up the global variable of t1
Tcount () {
    t2=`date +%s`

    local total_sec=$(( $t2 - $t1))
    local dur_min=$((total_sec / 60))
    local dur_remainder_sec=$((total_sec % 60))

    local msg="Duration = $dur_min min(s) and $dur_remainder_sec sec"
    echo -e $msg
}


##########################
# DURATION TOOLS
# This expects a start time submitted as an arg and assumes the end time as now
Calc_Duration() {
    local duration_msg_prefix=$1    
    local start_time=$2
    local log_file_path="$3"
    local end_time=`date +%s`

    local total_sec=$(( $end_time - $start_time ))
    local dur_hrs=$((total_sec / 3600 ))
    local dur_min=$((total_sec %3600 / 60))
    local dur_remainder_sec=$((total_sec %60))

    if [[ "$dur_hrs" = "0" ]]; then
        dur_hrs=""
    else
        dur_hrs="${dur_hrs} hrs"
    fi

    local msg="${duration_msg_prefix} ${dur_hrs} $dur_min min(s) and $dur_remainder_sec seconds"

    # if an arg comes in and is a file path, we can display and record to a file
    if [[ $log_file_path != "" ]]; then
        echo -e $msg ; echo -e $msg >> $log_file_path
    else
        echo -e $msg
    fi
}

Calc_Time() {
    local start_time=$1
    local end_time=`date +%s`
    local total_sec=$(( $end_time - $start_time ))
    local dur_min=$((total_sec / 60))
    local dur_remainder_sec=$((total_sec % 60))

    if [[ $dur_remainder_sec < 10 ]]; then
        echo "${dur_min}:0${dur_remainder_sec}"
    else
        echo "${dur_min}:${dur_remainder_sec}"
    fi
}

Calc_Time_Minutes_in_Percent() {

    # git actions didn't like this. It says it returns a exit code of 1 ??? works here.
    # so we will just copy paste code from Calc_Time
    # local actual_duration=$(Calc_Time $1)

    # split off the seconds and turn it into a a percent.
    # readarray -d ":" -t time_array <<< "$actual_duration"

    #local dur_min="${time_array[0]}"
    #local dur_sec="${time_array[1]}"
    #local num_dur_sec=$((dur_sec))

    local start_time=$1
    local end_time=`date +%s`
    local total_sec=$(( $end_time - $start_time ))
    local dur_min=$((total_sec / 60))
    local dur_remainder_sec=$((total_sec % 60))
    local dur_sec_percent=$((100 * $dur_remainder_sec / 60))

    if [[ $dur_sec_percent < 10 ]]; then
        echo "${dur_min}.${dur_sec_percent}"
    else
        echo "${dur_min}.${dur_sec_percent}"
    fi
}

##########################
# ERROR HANDLING

# When we use this error handling system, we have some key requirements.
# 1) the top .sh header declaring CAN NOT include -e as "TRAP"s will not file if -e is in place.

# 2) but must included:
#     set -o pipefail  # Crucial: Forces the pipe to fail if the subscript fails but only when a pipe is used.
#     set -o errtrace  # Inherit trap inside functions/subshells

# 3) It must include the "trap" command with specific arguments.
#    trap 'handle_error "${PIPESTATUS[*]}" $LINENO $Some_log_file_path' ERR
#       - 'handle_error'  is the name of this function
#       - "${PIPESTATUS[*]}"  is an array of 1 to many exit status codes (0 - 255 generally)
#       - $LINENO  is a special bash value available available when an exception is detected. 
#         which gives you the line of the error.
#       - $Some_log_file_path is a location of a log file. Some scripts like post processing, it wants
#         to send it directly to its own log file.
#         Some such as fim_process_huc.sh migth want to just send it to its own log file so it can be
#         scanned later for key words like error, exception, etc.
#       - "page_key": This helps identify which page is using this error handler.
#             - "post" (post processing): Always want an exit code of non zero to trigger and exit (stop further processing)
#             - "huc" (fim_process_huc.sh): Also wants the allow the non zero to exit
#             - "branch" (process_branch.sh): NEVER wants to stop its execution and always wants a 0 returned up to
#               it parent of run_huc.sh. The error message is logged and searched later, but having one branch
#               fail, by all branches returning a 0, means other branches wil continue to run even if one fails.
#               Especiall if it one of our special code like 61 - 65.
#
#       - ERR  is a critical key word that tell bash to look for errors

# Notes about ${PIPESTATUS[*]}
#   - If a page level .sh file has an error such as a fail on a grep command or another shell script, it will mean that ${PIPESTATUS[*]}
#     will have only one elements with its code
#   - HOWEVER.. We have some code that uses a subscript call to things like other .sh or .py files and is piped to "tee".
#        "tee", will always be called letting us to log all screen data including errors into a log file for us to scrap later for key error words.
#        When this happens, we will get two items in the PIPESTATUS array.
#           1) An exit code for success or fail code, such as 0, 1, 63, etc from the first part of the script such as a call to a py file or .sh script.
#           2) The second code is if the "tee" command was successful at saving the output (errors (STRERR) and screen data (STNOUT)), which will likely
#              always be zero as the "tee" command was successful at saving the data to the screeen.
#   - This is why we loop through the array to look for bad codes. We also have some custom codes (usually 60 to 65), that we know are "acceptable"
#        error codes that we want to log and handle differently depending on the context.

# Currenly, we want error handling on:
#   - fim_post_processing.sh, which has some .py piped to tee so it captures all of its output to its log file.
#   - fim_process_huc.sh, process_rerun_calibration_huc.sh, and process_branch as they also use a "tee" as a wrapper to a child .sh file.

# Notes about specifics for those pages.
#    - fim_pre_processing.sh:  It is a bit of an anonmoly based on our architecture. It does have the -e argument and is allowed to have it's page
#      fully fail on exit. AWS is able to catch this easily.
#         - This relys on another key bash tool called TRAP (a function name) EXIT. More details lower on EXIT handling.

#    - fim_process_huc.sh:  As it is part of an iterator, such as fim_pipeline.sh's "parallel" command, or in AWS Step Function wrapper, it MUST
#      always return a single exit code of 0 (success). Those pages are not covered by a "tee" wrapper above it, and we want it to be zero so that
#      other HUCs can be processed even if one fails. It relys on two key things:
#         - Log as much as it can about all activity and fails in its own huc_{huc number}_unit.log file. When it catches errors, it puts it inside its
#           its own log file and not an error file directly. Other tools will scan the "unit" log file and extract error data.
#         - As it is all processed in a "temp" folder, it criticaly relys on it copying its huc folder from temp to outputs. Otherwise it gets lost
#           and will never be seen by any log error scanning tools. CRITICAL.
#         - This relys on another key bash tool called TRAP (a function name) EXIT. More details lower on EXIT handling.

#    - process_branch.sh:  While this is only called inside run_unit.sh, it is also a part of the bash "parallel" command. If we let a process_branch
#      return anything other than a zero, it compromises the rest of the branches being processed. Besides, all of it's errors and outputs are further
#      saved up to run_huc.sh, then to fim_process_huc.sh, so we have all of the output and errors we need in order to scan the huc log file later.
#      Note: While we do create branch logs, we technically do not need them as it is already included in the rollup to process_branch -> run_huc.sh 
#      then fim_process_huc.sh.  
#      RESULT: We don't want to scan branch files for errors as we will always get duplicate error line data.

#    - process_rerun_calibration_huc.sh: Has the same system of calling its child .sh and using "tee", then parsing its error codes, like others.
#      This app could be allowed to return 0 or any other exit code as it is only called via tools/rerun_calibration.py which pythons subscript error handling
#      which is far easier. Why do we not let calibrate_rating_curves.sh to be called directly? It is used in two contexts, one being run_huc.sh and the other
#      is the rerun calib system. If we let calibrate_rating_curves.sh attempt to do its own error handling, it woudl be fine for rerun_calibration.py but 
#      can have certain types of errors be missed going up to run_huc.sh -> fim_process_huc.sh.
#      I know it sounds weird, but it is easier to have the "process_rerun_calibration_huc.sh" as a wrapper usign the "tee" command in the way that it is used
#      by run_unit.sh -> fim_process_huc.sh

# TRAP (a function name) EXIT
#   This is a bash tool that no matter what happens, errors or not, will execute last. We use it as a critical part of fim_process_huc.sh to help get it
#   moved from the temp dir to the output dir and also return a page level exit code of 0 (success).

# CAVEATS:
#   This system is not perfect and we want to be super careful where we add the TRAP ... ERR  and TRAP.. EXIT  commands.
#   They both rely on some key variables pre-existing such as log file path of some sort, be it an error file or standard log file.
#   We also will not attempt to let our TRAP error system catch some basic input argument tests, like is the -n runname argument supplied.
#   While this does leave a very small whole for copying it to other dirs, we deemed it acceptable as when you are running the sytem in fim_pipeline mode
#   you visually see it immediately.  When you are running it in AWS where you have no visible screens to see it, AWS can handle catestrophic errors easily
#   The AWS challenge it how many HUCs it handles and how it manages them in relation to its own logging system. We would need to build a very exceptionally
#   in depth AWS logging system which is not in place and would take a lot to make it. Hence, we try to log everything ourselves.
#   The two commands of TRAP ... ERR  and  TRAP... EXIT are in key strategic places. You will also notice that only fim_post_processing and fim_process_huc.sh
#   use TRAP .. EXIT, the others are already covered by another parent .sh or .py file directly or indirectly.  fim_post_processing.sh and fim_process_huc.sh
#   run fully independantly self encapsulated.  Techinally, fim_pre_processing.sh should have it too, but it is just one small file that is easily handled
#   by both fim_pipeline.sh  or AWS respectively.

# FINAL THOUGHT:
#   I know this is all very goofy and non standard, but it is the arch that was started 7+ years ago and has to be maintained until we get out of the bash 
#   business. And, as I mentioned, we don't want to make that jump all at one time, but can start grouping up sets of .py files into .py wrappers that are called
#   by its parent .sh. Eventally, the .sh will have only one .py file handing all child .py files, which will result in that .sh able to be retired.
#   ie) process_branch.sh: We can slowly grouping up all of the py files into py file wrappers. See our new run_taudem_subprocess.py for an example.
#   When we get down to only one remaining .py call inside the process_branch.sh, we can drop the .sh file and let run_unit.sh call directly to the new process_branch.py
#   file.  This lets us slowly migrate and we will absolutely want to transition slowly.

# This handles errors on some script such as fim_process_huc.sh, and fim_post_processing.sh, where their is an error
# not already trapped a "tee" command
handle_error() {
    
    local line_number="$1"
    local log_file="$2"
    local return_code=$3
    local last_command="$BASH_COMMAND"
    local page_source="${BASH_SOURCE[1]}"

    if [[ $return_code -eq 0 ]]; then
        echo ""
        # do nothing
    else  # could be an exit status of 1 but can be other codes as well.
        # It is possible that some errors may not show up huc log file depending
        # how catastrophic the error was. It is possible that an exception
        # could show up in our error log file twice and that is ok.
        # It may or may not already have been see by "tee" and is in the std log file.
        l_echo "----------------------------------------" $log_file
        l_echo "***** handle_error error detected Exit status: $return_code detected *****"  $log_file
        l_echo "   File: ${page_source}" $log_file
        l_echo "   Command: ${last_command}" $log_file
        l_echo "   Line Number: $line_number" $log_file
        l_echo "----------------------------------------" $log_file
        exit $return_code0
    fi
}
