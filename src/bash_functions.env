#!/bin/bash


## Simple logging system

# If this value -nq "", then functions in this file will be printed to
# console and log file.
log_file_path=""

# If this is set, all functions will set to a file as well as screen
# Yes. it needs some validation that the log_file_path is a valid
# file name and path.
Set_log_file_path () {
    log_file_path=$1

    if [ ! -f $log_file_path ]; then
        touch $log_file_path
    else
        rm -f $log_file_path
    fi
}

# to stop other calls to make log calls to this all
Clear_log_file_path () {

    log_file_path=""
}


# if the log_file_path has been set, this will print to screen and add to log file
l_echo () {
    local msg=$1

    if [[ $log_file_path != "" ]]; then
        echo -e $msg ; echo -e $msg >> $log_file_path
    else
        echo -e $msg
    fi
}


## Timing functions

T_total_start () {
    t0=`date +%s`
}

Tstart () {
    t1=`date +%s`
}

# This one is based on the value of t1 created earlier, and end is now
Tcount () {
    t2=`date +%s`

    local total_sec=$(( $t2 - $t1))
    local dur_min=$((total_sec / 60))
    local dur_remainder_sec=$((total_sec % 60))

    local msg="Duration = $dur_min min(s) and $dur_remainder_sec sec"
    # if an arg comes in and is a file path, we can display and record to a file
    if [[ $log_file_path != "" ]]; then
        echo -e $msg ; echo -e $msg >> $log_file_path
    else
        echo -e $msg
    fi

}

# This expects a start time submitted as an arg and assumes the end time as now
Calc_Duration( ) {
    local duration_msg_prefix=$1
    local start_time=$2
    local end_time=`date +%s`

    local total_sec=$(( $end_time - $start_time ))
    local dur_hrs=$((total_sec / 3600 ))
    local dur_min=$((total_sec %3600 / 60))
    local dur_remainder_sec=$((total_sec %60))

    if [[ "$dur_hrs" = "0" ]]; then
        dur_hrs=""
    else
        dur_hrs="${dur_hrs} hrs"
    fi

#    local msg="${duration_msg_prefix} $dur_min min(s) and $dur_remainder_sec sec"
    local msg="${duration_msg_prefix} ${dur_hrs} $dur_min min(s) and $dur_remainder_sec seconds"


    # if an arg comes in and is a file path, we can display and record to a file
    if [[ $log_file_path != "" ]]; then
        echo -e $msg ; echo -e $msg >> $log_file_path
    else
        echo -e $msg
    fi
}


Calc_Time() {
    local start_time=$1
    local end_time=`date +%s`
    local total_sec=$(( $end_time - $start_time ))
    local dur_min=$((total_sec / 60))
    local dur_remainder_sec=$((total_sec % 60))

    if (( $dur_remainder_sec < 10 )); then
        echo "$dur_min:0$dur_remainder_sec"
    else
        echo "$dur_min:$dur_remainder_sec"
    fi

}

Calc_Time_Minutes_in_Percent(){

    # git actions didn't like this. It says it returns a exit code of 1 ??? works here.
    # so we will just copy paste code from Calc_Time
    #local actual_duration=$(Calc_Time $1)


    # split off the seconds and turn it into a a percent.
    #readarray -d ":" -t time_array <<< "$actual_duration"

    #local dur_min="${time_array[0]}"
    #local dur_sec="${time_array[1]}"
    #local num_dur_sec=$((dur_sec))

    local start_time=$1
    local end_time=`date +%s`
    local total_sec=$(( $end_time - $start_time ))
    local dur_min=$((total_sec / 60))
    local dur_remainder_sec=$((total_sec % 60))
    local dur_sec_percent=$((100*$dur_remainder_sec/60))

    if (( $dur_sec_percent < 10 )); then
        echo "$dur_min.$dur_sec_percent"
    else
        echo "$dur_min.$dur_sec_percent"
    fi
}

#######################################################################################################################
##                                                                                                                   ##
##      Bash functions for slurm_pipeline.sh                                                                         ##
##                                                                                                                   ##
##                                                                                                                   ##
#######################################################################################################################

## Address the huc_list as a bash string or file
set_huc_list() {
    # Expects the following variables to be set in the calling environment:
    # restart, huc_list, parent_inputs_dir, outputsDir, run_name

    local relativeHucList num_hucs
    local outputDestDir directory prefix suffix
    local restart_huc_count
    local file huc

    if [ "$restart" -eq 0 ]; then
        # Substitute /data/ in $huc_list with $parent_inputs_dir
        relativeHucList="${huc_list/data/$parent_inputs_dir}"
        # Count number of HUCs (lines)
        num_hucs=$(wc -l < "$relativeHucList")
        # huc_level=$(head -n 1 "$relativeHucList" | wc -c | awk '{print $1-1}')
        huc_level=$(awk '{ if (length > max) max = length } END { print max }' "$relativeHucList")
        all_same_length=$(awk 'NR==1{l=length} length!=l{exit 1}' "$relativeHucList" && echo "true" || echo "false")
        if [[ "$all_same_length" == "false" ]]; then
            printf "\n\t ERROR: Not all hucs in ${relativeHucList} are the same length."
            printf "\n\t ERROR: Correct HUCs in ${relativeHucList} and re-submit."
            return 2
        fi
        return 0
    fi

    if [ "$restart" -gt 0 ]; then
        outputDestDir="$outputsDir/$run_name"
        directory="$outputDestDir/unit_errors"
        prefix="$outputsDir/$run_name/unit_errors/"
        suffix="_unit.log"

        if [ ! -d "$directory" ]; then
            printf "\n\t ERROR: unit_errors directory: '$directory' does not exist."
            return 1
        fi

        restart_huc_count=0
        for file in "$directory"/*; do
            [ -f "$file" ] || continue
            huc="${file#$prefix}"   # Remove prefix
            huc="${huc%$suffix}"    # Remove suffix
            ((restart_huc_count++))
            hucList_restart+="$huc "
        done

        # Remove any leading or trailing spaces
        hucList_restart="$(echo "$hucList_restart" | xargs)"

        if [ -z "$hucList_restart" ]; then
            printf "\n\t ERROR: No HUCs to re-issue in '$run_name' directory.\n"
            return 1
        fi

        if [ ! -z "$hucList_restart" ]; then
            echo -e "\n\t huclist_restart compiled. Will re-issue $restart_huc_count hucs: \n\n\t\t $hucList_restart"
            first=${hucList_restart%% *}
            huc_level=${#first}
            return 0
        fi

        return 0
    fi
}
#######################################################################################################################

## Unfortunately, Slurm on PW does not currently report on accurate Memory values if a node is not operational.
## e.g. `sinfo -Nel` shows a MEMORY value of 1 for all nodes. 
## Gathering memory would be optimal, as FIM is memory bound. Instead, we must "hard-code" certain "approved instances"
## when identified as optimal. The enforce_instance_type function gathers the instance type from the cluster's slurm config
## file (/cluster/etc/slurm.conf) and enforces "approved instances" per huc level and resolution. 

enforce_instance_type() {
    # Read node type
    compute_node_instance_type=$(grep "^PartitionName=compute1" /cluster/etc/slurm/slurm.conf \
        | sed -n 's/.*Nodes=\([^[]*\).*/\1/p' \
        | xargs -I {} grep "^NodeName={}0001 " /cluster/etc/slurm/slurm.conf \
        | sed -n 's/.*Features="[^"]*shape=\([^,"]*\).*/\1/p')

    # Set approved instance types
    approved_huc8_instance_size_10m="c6i.8xlarge"
    approved_huc10_instance_size_10m="c6i.4xlarge"
    approved_huc12_instance_size_10m="c6i.2xlarge"
    approved_huc12_instance_size_5m="c6i.4xlarge"
    approved_huc12_instance_size_3m="r6a.4xlarge"

    # Compose the variable name dynamically
    approved_var="approved_huc${huc_level}_instance_size_${res}m"
    approved_size="${!approved_var}"

    case "${res}_${huc_level}" in
      # Disallow combinations
      5_8|3_8)
        printf "\n\t ERROR: It is not recommended to process the HUC${huc_level} level at ${res}m resolution. \n"
        return 2
        ;;
      # Warn on untested combinations
      5_10|3_10)
        if [[ "$compute_node_instance_type" == "$approved_huc12_instance_size_10m" ]]; then
            printf "\n\t ERROR: Instance type $compute_node_instance_type not suitable for HUC${huc_level} at ${res}m.\n"
            return 2
        else
            printf "\n\t WARNING: Processing at HUC${huc_level} scale at ${res}m resolution is untested.\n"
            printf "\t WARNING: Out of Memory errors may occur. Use at your own discretion.\n"
            return 0
        fi
        ;;
      # HUC12 @ 10m & 5m, HUC10 @ 10m, HUC8 @ 10m require approved type checks and possibly warning
      10_8|10_10|10_12|5_12|3_12)
        if [[ "$compute_node_instance_type" != "$approved_size" ]]; then
            # These models all support warning on (supported but oversized)
            warn_types=""
            [[ $res == 10 && $huc_level == 8  ]] && warn_types="$approved_huc12_instance_size_3m"
            [[ $res == 10 && $huc_level == 10 ]] && warn_types="$approved_huc12_instance_size_3m $approved_huc8_instance_size_10m"
            [[ $res == 10 && $huc_level == 12 ]] && warn_types="$approved_huc12_instance_size_3m $approved_huc12_instance_size_5m \
                                                    $approved_huc10_instance_size_10m $approved_huc8_instance_size_10m"
            [[ $res == 5  && $huc_level == 12 ]] && warn_types="$approved_huc12_instance_size_3m $approved_huc8_instance_size_10m"

            if [[ " $warn_types " == *" $compute_node_instance_type "* ]]; then
                printf "\n\t WARNING: The instance type on compute1 is $compute_node_instance_type. "
                printf "\n\t WARNING: This instance type is not optimal (overprovisioning of resources)."
                printf "\n\t WARNING: You will incur unnecessary costs. Reconfigure your cluster with $approved_size or similar.\n"
                return 0
            fi
            printf "\n\t ERROR: Instance type $compute_node_instance_type not suitable for HUC${huc_level} at ${res}m.\n"
            printf "\t ERROR: Please reconfigure your cluster with $approved_size or similar/greater.\n"
            return 2
        fi
        return 0
        ;;
      *)
        printf "\n\n\t ERROR: Either invalid resolution variable ($res) defined in "$im_path"/config/params_template.env OR "
        printf "\n\t ERROR: invalid HUC with a length of "$huc_level" provided in $relativeHucList."
        printf "\n\t ERROR: Please either change the res variable in "$im_path"/config/params_template.env to be: 10, 5, or 3." 
        printf "\n\t ERROR: OR provide a HUCLIST with HUC6, HUC8, HUC10, or HUC12s. \n"
        printf "\n\t ERROR: " 
        return 2
        ;;
    esac

    return 0
}

#######################################################################################################################

## Export Functions 
export -f T_total_start
export -f Tstart
export -f Tcount
