# If you need to update this full_huc_list, make sure you update:
# this repo version, the inputs/huc_list/full_huc_lists.lst and the other enviros such as ESIP, S3 and Dev1.
# The version in the repo is used to validate that we do not have a HUC that was submitted in the -u (huc list)
# arguments that is not approved and on the repo version of the full_huc_list. But all copies of that file
# should stay in sync as mentioned above.
export full_huc_list_file=/foss_fim/config/huc_lists/full_huc_list.lst

# NOTE: $inputsDir is defined in Dockerfile


