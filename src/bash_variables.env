# This covers only HUC8's in CRS 102039. It does not need to be in split projections per HUC as it is used primarily
# by tools_shared_functions.py.aggregate_wbd_hucs to find nwm points against HUC8's.
# It will eventually replace all of .env files that had the full WBD HUC2,4,6,8 non filtered. It was 800 MiB and was
# very slow to load. For now, at least this version is half of its size until we come up with something better
# like iterating HCU and their pre-clips (re-projecting if/as we need). This new one can load in under 6 mins.
export                        input_wbd_layer=${inputsDir}/wbd/WBD_National_HUC8_HAND_domain_20251209.gpkg

