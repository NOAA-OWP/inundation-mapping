## Temporary image to build the libraries and only save the needed artifacts
## just to build Taudem, then we use an ubuntu image below.
FROM python:3.12-slim AS taudem_builder

RUN echo "++++++++++++++++++++++++++++++++++++++++++++++\n Stage 1: Starting build: $(date)"

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /opt/builder

ARG depDir=/dependencies
ARG taudemVersion=98137bb6541a0d0077a9c95becfed4e56d0aa0ac
ARG taudemVersion2=81f7a07cdd3721617a30ee4e087804fddbcffa88
ENV taudemDir=$depDir/taudem/bin
ENV taudemDir2=$depDir/taudem_accelerated_flowDirections/taudem/build/bin

## ============================
RUN apt-get update && apt-get install -y --no-install-recommends \
    git cmake make gcc g++ libgdal-dev mpich libmpich-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

## ============================
## Clone repositories
RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    echo "Stage 1: Git clone and branch checkout and build for tauDEM"
RUN git clone https://github.com/dtarb/taudem.git
RUN git clone https://github.com/fernandoa123/cybergis-toolkit.git taudem_accelerated_flowDirections

## ============================
## Compile Main taudem repo ##
RUN mkdir -p taudem/bin
RUN cd taudem \
    && git checkout $taudemVersion \
    && cd src \
    && make

## ============================
## Compile taudem repo with accelerated flow directions ##
RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    echo "Stage 1: Git clone and branch checkout and build for taudem_accelerated_flowDirections: $(date)"
RUN cd taudem_accelerated_flowDirections/taudem \
    && git checkout $taudemVersion2 \
    && mkdir build \
    && cd build \
    && cmake .. \
    && make

## ============================
## Move needed binaries to the next stage of the image
RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    echo "Stage 1: tauDEM cleanup: $(date)"

RUN mkdir -p $taudemDir
RUN mkdir -p $taudemDir2
RUN cd taudem/bin \
     && mv -t $taudemDir flowdircond streamnet gagewatershed catchhydrogeo dinfdistdown
RUN cd taudem_accelerated_flowDirections/taudem/build/bin \
     && mv -t $taudemDir2 d8flowdir dinfflowdir

## ============================
## Fix permissions before copying to final stage
RUN chown -R root:root $depDir && chmod -R 777 $depDir

RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    echo "Stage 1: Complete: $(date)\n"

#####################################

RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
echo "Stage 2: Starting Stage 2 GDAL and PROJ build: $(date)"

# Step 1: Use the official OSGeo GDAL base image
FROM ghcr.io/osgeo/gdal:ubuntu-small-3.13.3 AS base

ARG dataDir=/data
ARG depDir=/dependencies

ENV projectDir=/foss_fim
ENV inputsDir=$dataDir/inputs
ENV outputsDir=/outputs
ENV srcDir=$projectDir/src
ENV toolsDir=$projectDir/tools
ENV workDir=/fim_temp
ENV taudemDir=$depDir/taudem/bin
ENV taudemDir2=$depDir/taudem_accelerated_flowDirections/taudem/build/bin

ENV LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    DEBIAN_FRONTEND=noninteractive \
    TZ=UTC

# Set system environment variables to prevent Python issues inside Docker
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

## ============================
RUN mkdir -p $workDir

COPY --from=taudem_builder $depDir $depDir
RUN chown -R root:root $depDir && chmod -R 777 $depDir

ENV PATH="${projectDir}:${PATH}"

## ADD TO PYTHON PATHS ##
ENV PYTHONPATH="${projectDir}:\
${srcDir}:\
${srcDir}/utils:\
${projectDir}/data:\
${toolsDir}"

## ADDING FIM GROUP ##
ARG GroupID=1370800235
ARG GroupName=fim
RUN groupadd --gid $GroupID $GroupName
ENV GID=$GroupID
ENV GN=$GroupName


RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    echo "Stage 2: Apt downloads and setup: $(date)"

# 2. Strict Single-Threading limits for internal libraries.
# This prevents thread-multiplication chaos when you spawn a Python ProcessPool 
# or run several GNU parallel jobs at once.
ENV OMP_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    VECLIB_MAXIMUM_THREADS=1 \
    NUMBA_NUM_THREADS=1 \
    GDAL_NUM_THREADS=1

# ==============================================================================
# GDAL PERFORMANCE TUNING
# ==============================================================================
# 1. Prevent massive directory indexing slowdowns
ENV GDAL_DISABLE_READDIR_ON_OPEN=EMPTY_DIR

# 2. Expand internal GDAL RAM memory caching (Defaults to only 5% of RAM)
ENV GDAL_CACHEMAX=1024

# Enhanced settings for large multi-file mosaics
ENV GDAL_MAX_DATASET_POOL_SIZE=2000 \
    CPL_VSIL_CURL_ALLOWED_EXTENSIONS=".tif .tiff .vrt"


# ==============================================================================
# GPKG & GEOPARQUET VECTOR OPTIMIZATIONS
# ==============================================================================
# 1. Cache SQLite operations in RAM instead of thrashing the disk mount
ENV OGR_SQLITE_CACHE=512

# 2. Force SQLite/GPKG to commit in fast memory pools (safe for read-heavy Docker)
ENV OGR_SQLITE_SYNCHRONOUS=OFF

# 3. Stream only the required byte-ranges for GeoParquet files
ENV GDAL_HTTP_MERGE_CONSECUTIVE_RANGES=YES

## ============================
# Grab the official 'uv' binary using a multi-stage copy
ENV UV_COMPILE_BYTECODE=1
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# ===========
# Set the working directory to your dynamic mount point
WORKDIR /foss_fim

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        time parallel \
        htop acl \
        p7zip-full unzip git \
        rsync tzdata wget osmium-tool \
        python3-dev build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*


# Step 4: Create the virtual environment and install requirements
# We copy requirements.txt to a temporary directory so it survives your volume mount
COPY requirements-313.txt /tmp/requirements.txt

# Create the environment in /opt/venv and let uv install everything cleanly
RUN uv venv /opt/venv && \
    . /opt/venv/bin/activate && \
    uv pip install -r /tmp/requirements.txt

# Ensure the virtual environment is automatically active for all runtime execution
ENV PATH="/opt/venv/bin:$PATH"

# NOTE: We do NOT use "COPY . ." here because your 'foss_fim' mount 
# handles injecting the code dynamically at runtime.

# Reset workspace context directly back to root for your entrypoint launcher context
WORKDIR /

COPY src/entrypoint.sh /
ENTRYPOINT ["/bin/bash", "entrypoint.sh"]
