#     make -j$(nproc) && \
#     make install && \
#     ldconfig

# Clone the official TauDEM repository
WORKDIR /opt
# RUN git clone https://github.com/dtarb/TauDEM.git \
#     && cd TauDEM \
#     && git checkout -b v5.5.0

# Note: --depth 1 means a simple clone and not all of the history, just the recent commit
RUN git clone --branch v5.5.0 --depth 1 https://github.com/dtarb/TauDEM.git \
    && cd TauDEM

# ROB: Get specific version

# Build TauDEM using CMake (CMake will automatically bind to the built-in GDAL 3.12 paths)
WORKDIR /opt/TauDEM/src
# RUN mkdir build && cd build && \
#     cmake -DCMAKE_BUILD_TYPE=Release -DINTERPROCEDURAL_OPTIMIZATION=OFF .. && \
#     make -j$(nproc) && \
#     make install

# RUN mkdir build && cd build && \
#     cmake -DCMAKE_BUILD_TYPE=Release .. && \
#     sed -i 's/-flto=auto -ffat-lto-objects//g' CMakeCache.txt && \
#     make -j$(nproc) && \
#     make install

# RUN mkdir build && cd build && \
#     # 1. CMAKE_VERBOSE_MAKEFILE=ON tells CMake to generate a verbose Makefile
#     # 2. Overriding CFLAGS/CXXFLAGS directly prevents the broken MPI LTO string injection
#     cmake -DCMAKE_BUILD_TYPE=Release \
#           -DCMAKE_VERBOSE_MAKEFILE=ON \
#           -DCMAKE_C_FLAGS="-O3" \
#           -DCMAKE_CXX_FLAGS="-O3" .. && \
#     # 3. VERBOSE=1 prints every raw g++ compilation command to your terminal logs
#     make VERBOSE=1 -j$(nproc) && \
#     make install

# RUN mkdir build && cd build && \
#     cmake -DCMAKE_BUILD_TYPE=Release .. && \
#     make -j$(nproc) && \
#     make install

# Linux with GCC
# 1. Configure the project and set the build directory to /taudem_builder/bin
RUN cmake -S . -B /opt/TauDEM/build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER=/usr/bin/gcc \
    -DCMAKE_CXX_COMPILER=/usr/bin/g++ \
    -DMPI_C_COMPILER=/usr/bin/mpicc \
    -DMPI_CXX_COMPILER=/usr/bin/mpicxx

# 2. Compile the files using the configured folder and compile for only the ones we want
RUN cmake --build /opt/TauDEM/build --target flowdircond streamnet gagewatershed catchhydrogeo d8flowdir pitremove

ARG TAUDEM_BIN_DIR=/TauDEM_builder/bin
RUN mkdir -p $TAUDEM_BIN_DIR \
    && cd /opt/TauDEM/build \
    && cp flowdircond streamnet gagewatershed catchhydrogeo d8flowdir pitremove ${TAUDEM_BIN_DIR}/

ENV OMPI_ALLOW_RUN_AS_ROOT=1 \
    OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

# Verify the binaries can run and output usage guides
# RUN /taudem_builder/bin/d8flowdir --help

# # Verify MPI execution framework works inside the container environment
# RUN mpiexec -n 2 /taudem_builder/d8flowdir --help

# ----------------------------------------------------
# 🔍 VISUAL DEBUG INTEGRATION TESTS
# NOTE: TauDEM does not have a --help option, so we look for a specific phrase to help validate it
# Technically, the output from the test calls here is an error as it the calls do not pass in
# args. But if the phrase does not exist, the binary is not present is invalid.
# ----------------------------------------------------
RUN echo "\n++++++++++++++++++++++++++++++++++++++++++++++" \
    echo "--- TESTING TauDEM Binary and MPIEXEC calls using b8flowdir --" \
    echo "    If you do not get an error, then both Binary and MPIEXEC are good\n"
RUN echo "--- testing binary ---" \
    && ${TAUDEM_BIN_DIR}/d8flowdir 2>&1 | grep -q "Simple Usage"
RUN echo "--- testing MPIExec calls ---" \
    && mpiexec --allow-run-as-root -n 2 ${TAUDEM_BIN_DIR}/d8flowdir 2>&1 | grep -q "Simple Usage"

# # Test 2: Print raw output of a parallel MPI wrapper call
# RUN echo "--- TESTING MPIEXEC FLOWDIR OUTPUT using d8flowdir ---" \
#     && mpiexec --allow-run-as-root -n 2 ${TAUDEM_BIN_DIR}/d8flowdir 2>&1 | grep -q "Simple Usage"

# RUN echo "\n*** NOTE:\n It will give an error as their are no args and d8flowdir does not have an --help option." \
#     echo "If you see 'Error: To run this program, use either the Simple Usage option or'" \
#     echo "Then it is able to module compiled just fine and mpiexec can see it just fine as well." 

RUN echo "\n\n++++++++++++++++++++++++++++++++++++++++++++++\n Stage 1: TauDEM build complete: $(date)"

# Keep this in this test taudem file only. Do not copy it into the Dockerfile.dev

# CMD ["/bin/bash"]

RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    echo "Stage 2: Starting Stage 2 build (final): $(date)"

# Docker will check your local machine for this image first
# TEMP test, using the local taudem image I created earlier
# FROM taudem_build_image_3:latest AS taudem_builder

FROM ghcr.io/osgeo/gdal:ubuntu-small-3.12.3

# 1. Global System Locales, Timezone, and Non-interactive Configurations
ENV LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    DEBIAN_FRONTEND=noninteractive \
    TZ=UTC
    
# # Only install runtime MPICH for parallel execution
# RUN apt-get update && apt-get install -y --no-install-recommends \
#     mpich \
#     && rm -rf /var/lib/apt/lists/*

# # Copy compiled TauDEM executables from the builder stage
# COPY --from=builder /usr/local/bin /usr/local/bin

# # Set the system path
# ENV PATH="/usr/local/bin:${PATH}"
# WORKDIR /data

# CMD ["pitremove"]

# 2. Setup Build Arguments and Sequential Environment Paths
ARG DATA_DIR=/data
ARG DEP_DIR=/dependencies
ARG TAUDEM_BIN_SRC_DIR=/TauDEM_builder/bin
ARG TAUDEM_BIN_TRG_DIR=$DEP_DIR/TauDEM/bin

ENV projectDir=/foss_fim
ENV inputsDir=$DATA_DIR/inputs \
    outputsDir=/outputs \
    srcDir=$projectDir/src \
    toolsDir=$projectDir/tools \
    workDir=/fim_temp


# Configure vital environment variables so system tools can find GDAL/PROJ
# ENV GDAL_VERSION=3.12.3 \
#     GDAL_CONFIG=/usr/bin/gdal-config \
#     PROJ_DIR=/usr/share/proj \
#     PROJ_LIB=/usr/share/proj \
#     PYPROJ_GLOBAL_CONTEXT=ON \
#     C_INCLUDE_PATH=/usr/include/gdal \
#     CPLUS_INCLUDE_PATH=/usr/include/gdal

#   FIXED PATHS: Point to /usr/local/share/proj instead of /usr/share/proj
ENV GDAL_VERSION=3.12.3 \
    GDAL_CONFIG=/usr/bin/gdal-config \
    PROJ_DIR=/usr/local/share/proj \
    PROJ_LIB=/usr/local/share/proj \
    PYPROJ_GLOBAL_CONTEXT=ON \
    C_INCLUDE_PATH=/usr/include/gdal \
    CPLUS_INCLUDE_PATH=/usr/include/gdal


# UV Optimizations for global system Python and faster container startup
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_SYSTEM_PYTHON=1 \
    UV_BREAK_SYSTEM_PACKAGES=1

# Set system environment variables to prevent Python issues inside Docker
# Also supress all FutureWarnings. We can wait until they become Warnings.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONWARNINGS="ignore::FutureWarning"

# Set other env variables
ENV PATH="${projectDir}:${DEP_DIR}:${PATH}"

COPY --from=taudem_builder $TAUDEM_BIN_SRC_DIR $TAUDEM_BIN_TRG_DIR
# RUN chown -R root:root $depDir && chmod -R 777 $depDir

## ============================
# Grab the official 'uv' binary using a multi-stage copy
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# ==============================================================================
RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    && echo "Stage 2: Apt downloads and setup: $(date)"

# System Packages, Runtime Utilities, and C++ Compilers (Must be before uv installs)
RUN apt-get update && apt-get install -y --no-install-recommends \
    # --- Permanent Runtime Utilities ---
    curl \
    time \
    parallel \
    p7zip-full \
    unzip \
    git \
    rsync \
    tzdata \
    wget \
    osmium-tool \
    ca-certificates \
    python3-gdal \
    mpich \
    openmpi-bin \
    # --- Temporary Python/Geospatial Build Tools needed in this script ---
    build-essential \
    python3-dev \
    python3-venv \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*


RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    && echo "Stage 2: Copy Pipfile and install packages: $(date)"

COPY ./constraints.txt constraints.txt 
ENV UV_CONSTRAINT="constraints.txt"

COPY ./requirements_v9_rebuild_20261019.txt requirements.txt

# RUN uv pip install --system -r requirements.txt

# # Pre-install the compilation engines
# # Leave these here, even if they are already in the requirements.txt file
# # and especially be careful with numpy versioning (also in the constraints.txt file)
# RUN --mount=type=cache,target=/root/.cache/uv \
#     uv pip install -c constraints.txt wheel setuptools cython versioneer

# # CRITICAL COMPATIBILITY FIX:
# # We wipe out the image's default pre-compiled binaries to prevent
# # mixed runtime conflicts.
# RUN --mount=type=cache,target=/root/.cache/uv \
#     uv pip uninstall -y numpy gdal

# # Install uv and compile the stack directly to the system python using local caching.
# # Fixed line-continuation spacing and explicitly injected the gdal[numpy] compiler flag.
# RUN --mount=type=cache,target=/root/.cache/uv \
#     uv pip install \
#         -c constraints.txt \
#         --no-binary gdal \
#         --no-binary fiona \
#         --no-binary rasterio \
#         --no-binary pyogrio \
#         --no-build-isolation \
#         "gdal[numpy]==3.12.3" \
#         -r requirements.txt


# Fully patch and normalize the global Python site-packages space
# We force-install your locked NumPy 2.2.6 framework alongside your build toolchain,
# completely overwriting any old system package hooks.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
        -c constraints.txt \
        --force-reinstall \
        wheel setuptools cython versioneer "numpy==2.2.6"

# # CRITICAL COMPATIBILITY FIX:
# # Remove the old system configuration, but make sure to preserve our pre-installed engines
# RUN --mount=type=cache,target=/root/.cache/uv \
#     uv pip uninstall gdal -y

# RUN --mount=type=cache,target=/root/.cache/uv \
#     uv pip install \
#         -c constraints.txt \
#         --no-binary gdal \
#         "gdal[numpy]==3.12.3"



# Compile the critical Geospatial Core from source DISTRIBUTION
# We isolate these three components so they compile cleanly against the exact
# C++ headers of your base image and the newly established NumPy 2 framework.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
        -c constraints.txt \
        --no-binary fiona \
        --no-binary rasterio \
        --no-binary pyogrio \
        --no-build-isolation \
        "fiona==1.10.1" \
        "rasterio==1.5.2" \
        "pyogrio==0.11.0"
    


# RUN apt-get purge -y --auto-remove g++ python3-dev build-essential \
#     && rm -rf /var/lib/apt/lists/*

# Install the remaining application packages (scipy, pandas, pymc, etc.)
# Now that your geospatial drivers are locked down, uv can safely parse the rest of 
# your requirements list out of the binary wheel ecosystem without any compilation errors.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install \
        -c constraints.txt \
        -r requirements.txt \
    && apt-get purge -y --auto-remove g++ python3-dev build-essential \
    && rm -rf /var/lib/apt/lists/*


## ******

## ADD GDAL Optimizations



# RUN apt-get purge -y --auto-remove g++ python3-dev \
#     && rm -rf /var/lib/apt/lists/*

# # 7 Configure paths and environmental permissions for Root execution
# ENV USER=root
# ENV HOME=/root

# ## ADD TO PYTHON PATHS ##
# ENV PYTHONPATH="/usr/lib/python3/dist-packages"
ENV PYTHONPATH="${projectDir}:${srcDir}:${srcDir}/utils:${projectDir}/data:${toolsDir}"

# # Lands the interactive terminal directly into your main project folder
# # Establish landing directory for your dynamic mount
# WORKDIR ${projectDir}

# # Expose port 8899 in case you want to launch Jupyter or JupyterLab from inside the container
EXPOSE 8899

COPY ./src/entrypoint.sh /
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]

CMD ["/bin/bash"]

RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    && echo "Stage 2: Complete: $(date)" \
    && echo "++++++++++++++++++++++++++++++++++++++++++++++"
