# ==========================================
###
### For more details about how this Dockerfile is designed, please see /docs/DOCKER_BUILDS.md.
###
# ==========================================
# Stage 1: Build Environment (Using OSGeo GDAL 3.12.3)
# ==========================================
FROM ghcr.io/osgeo/gdal:ubuntu-small-3.12.3 AS taudem_builder
RUN echo "++++++++++++++++++++++++++++++++++++++++++++++\n Stage 1: Starting TauDEM build: $(date)"

ENV DEBIAN_FRONTEND=noninteractive

# Install remaining system compilation prerequisites (GDAL is already baked in)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libmpich-dev \
    mpich \
    openmpi-bin \
    libopenmpi-dev \
    libtiff-dev \
    libgeotiff-dev \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Clone the official TauDEM repository
WORKDIR /opt

# Note: --depth 1 means a simple clone and not all of the history, just the recent commit
# Using TauDEM version 5.5.0
RUN git clone --branch v5.5.0 --depth 1 https://github.com/dtarb/TauDEM.git \
    && cd TauDEM

# Build TauDEM using CMake (CMake will automatically bind to the built-in GDAL 3.12 paths)
WORKDIR /opt/TauDEM/src

# Linux with GCC
# Configure the project and set the build directory to /taudem_builder/bin
RUN cmake -S . -B /opt/TauDEM/build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_C_COMPILER=/usr/bin/gcc \
    -DCMAKE_CXX_COMPILER=/usr/bin/g++ \
    -DMPI_C_COMPILER=/usr/bin/mpicc \
    -DMPI_CXX_COMPILER=/usr/bin/mpicxx

# Compile the files using the configured folder and compile for only the ones we want
RUN cmake --build /opt/TauDEM/build --target flowdircond \
    streamnet gagewatershed catchhydrogeo d8flowdir pitremove

ARG TAUDEM_BIN_DIR=/TauDEM_builder/bin
RUN mkdir -p $TAUDEM_BIN_DIR \
    && cd /opt/TauDEM/build \
    && cp flowdircond streamnet gagewatershed catchhydrogeo d8flowdir pitremove ${TAUDEM_BIN_DIR}/

ENV OMPI_ALLOW_RUN_AS_ROOT=1 \
    OMPI_ALLOW_RUN_AS_ROOT_CONFIRM=1

# # ----------------------------------------------------
# # 🔍 VISUAL DEBUG INTEGRATION TESTS
# # NOTE: TauDEM does not have a --help option, so we look for a specific phrase to help validate it
# # Technically, the output from the test calls here is an error as it the calls do not pass in
# # args. But if the phrase does not exist, the binary is not present is invalid.
# # ----------------------------------------------------
# RUN echo "\n\n*******************************************" \
#     echo "--- TESTING Stage 1 TauDEM Binary and MPIEXEC calls using b8flowdir --" \
#     echo "\n--- testing binary ---"
# RUN ${TAUDEM_BIN_DIR}/d8flowdir 2>&1 | grep -q "Simple Usage"
# RUN echo "--- testing MPIExec calls ---" \
#     && mpiexec --allow-run-as-root -n 2 ${TAUDEM_BIN_DIR}/d8flowdir 2>&1 | grep -q "Simple Usage"

# RUN echo "\n\nIf you do not see the word Error above in this test block, " \
#     echo "then TauDEM and mpiexec should be fine (tested against d8flowdir)." 

# # Give it 30 seconds for the user to read possible TauDEM error
# RUN sleep 30 && echo "*** CTRL-C to abort if you see unacceptable errors from TauDEM Stage 1."

RUN echo "\n\n++++++++++++++++++++++++++++++++++++++++++++++\n Stage 1: TauDEM build complete: $(date)"

# ==========================================
# Stage 2: Main Build Environment (Using OSGeo GDAL 3.12)
# ==========================================
FROM ghcr.io/osgeo/gdal:ubuntu-small-3.12.3 AS main_builder

# ------------------------
# TauDEM Stage Debugging
# See comments about easier, quicker debugging options as described in /docs/DOCKER_BUILDS.md.
# FROM taudem_debug_image:latest AS taudem_builder
# ------------------------

# Global System Locales, Timezone, and Non-interactive Configurations
ENV LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    DEBIAN_FRONTEND=noninteractive \
    TZ=UTC
    
# Setup Build Arguments and Sequential Environment Paths
ARG DATA_DIR=/data
ARG DEP_DIR=/dependencies

ENV projectDir=/foss_fim
ENV inputsDir=$DATA_DIR/inputs \
    outputsDir=/outputs \
    srcDir=$projectDir/src \
    toolsDir=$projectDir/tools \
    workDir=/fim_temp

ENV GDAL_VERSION=3.12.3 \
    GDAL_CONFIG=/usr/bin/gdal-config \
    PROJ_DIR=/usr/local/share/proj \
    PROJ_LIB=/usr/local/share/proj \
    PYPROJ_GLOBAL_CONTEXT=ON \
    C_INCLUDE_PATH=/usr/include/gdal \
    CPLUS_INCLUDE_PATH=/usr/include/gdal

# Set system environment variables to prevent Python issues inside Docker
# Also supress all FutureWarnings. We can wait until they become Warnings.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONWARNINGS="ignore::FutureWarning"

# Set other env variables
ENV PATH="${projectDir}:${DEP_DIR}:${PATH}"
## ADD TO PYTHON PATHS ##
ENV PYTHONPATH="${projectDir}:${srcDir}:${srcDir}/utils:${projectDir}/data:${toolsDir}"

# This helps with permissions when writing to drives.
ARG GroupID=1370800235
ARG GroupName=fim
RUN groupadd --gid $GroupID $GroupName
ENV GID=$GroupID
ENV GN=$GroupName

## ============================
# Copy TauDEM binaries into image
ARG TAUDEM_BIN_SRC_DIR=/TauDEM_builder/bin
ENV taudemDir=$DEP_DIR/TauDEM/bin
COPY --from=taudem_builder $TAUDEM_BIN_SRC_DIR $taudemDir
RUN chmod -R 777 $DEP_DIR

## ============================
# Grab the official 'uv' binary using a multi-stage copy
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# ==============================================================================
RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    && echo "Stage 2: Apt downloads and setup: $(date)"

# System Packages, Runtime Utilities, and C++ Compilers (Must be before uv installs)
RUN apt-get update && apt-get install -y --no-install-recommends \
    # --- Permanent Runtime Utilities ---
    curl \
    time \
    parallel \
    p7zip-full \
    unzip \
    git \
    rsync \
    tzdata \
    wget \
    osmium-tool \
    ca-certificates \
    python3-gdal \
    mpich \
    openmpi-bin \
    # --- Temporary Python/Geospatial Build Tools needed in this script ---
    build-essential \
    python3-dev \
    python3-venv \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    && echo "Stage 2: Copy Pipfile and install packages: $(date)"

# UV Optimizations for global system Python and faster container startup
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_SYSTEM_PYTHON=1 \
    UV_BREAK_SYSTEM_PACKAGES=1

COPY ./constraints.txt constraints.txt 
ENV UV_CONSTRAINT="constraints.txt"

# Core Geospatial Stack Compilation Phase
# We explicitly install setuptools and wheel first so the GDAL build backend has them available,
# then we compile the core stack against NumPy 2.x.
# UV_BREAK_SYSTEM_PACKAGES=1 needs to be on for this Dockerfile level us pip install
RUN uv pip install --system --no-cache \
     "numpy>=2.0.0" "setuptools" "wheel" && \
    uv pip install --system --no-cache \
    --no-build-isolation \
     "gdal[numpy]==$(gdal-config --version).*" "pyogrio" && \
    uv pip install --system --no-cache \
    --no-binary fiona \
    --no-binary rasterio "fiona" "rasterio"

COPY ./requirements.txt requirements.txt

RUN uv pip install --system --no-cache \
    -c constraints.txt \
    -r requirements.txt

RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    echo "Stage 2: Set up Micro Mamba: $(date)"

# Install a newer PDAL runtime than the Ubuntu package currently provides.
ENV MAMBA_ROOT_PREFIX=/opt/micromamba
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
        MAMBA_ARCH="linux-aarch64"; \
    else \
        MAMBA_ARCH="linux-64"; \
    fi && \
    wget --no-verbose -O- https://micro.mamba.pm/api/micromamba/${MAMBA_ARCH}/latest | tar -xvj -C /usr/local/bin --strip-components=1 bin/micromamba && \
    micromamba create -y -p /opt/pdal-env -c conda-forge pdal=2.9.3 gdal proj proj-data && \
    micromamba clean --all --yes

ENV PDAL_CLI_PATH="/opt/pdal-env/bin/pdal"
ENV PDAL_ENV_ROOT="/opt/pdal-env"


RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    && echo "Stage 2: Install AWS CLI: $(date)"
RUN curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" && \
     unzip -qo awscliv2.zip && \
     ./aws/install && \
     rm awscliv2.zip


RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    && echo "Stage 2: Configure Whitebox: $(date)"
# ----------------------------------
# +++ Whitebox
# Mar 2023 / Sep 2024
# There are some nuances in the whitebox python downloads in that the first time it loads
# it goes to the internet and downloads the latest/greatest WBT (whiteboxtools) engine which is
# required for the whitebox python library to work. We don't want to have FIM attempting a download
# each time a container is opened and the whitebox engine is called.
# Instead we will setup the WBT engine at time of docker build (same as Taudem and AWS).
# Whitebox code detects that the engine it there and makes no attempt to update it.
# We download and unzip it to the same file folder that pip deployed the whitebox library.
# Whitebox also attempts to always download a folder called testdata regardless of use.
# We added an empty folder to fake out whitebox_tools.py so it doesn't try to download the folder
#ENV WBT_PATH=/usr/local/lib/python3.12/dist-packages/whitebox/WBT
# ENV WBT_EXE_PATH=/usr/local/lib/python3.12/dist-packages/whitebox/whitebox_tools
# RUN wget -P $WBT_PATH https://www.whiteboxgeo.com/WBT_Linux/WhiteboxTools_linux_musl.zip && \
#     unzip -o $WBT_PATH/WhiteboxTools_linux_musl.zip -d $WBT_PATH && \
#     cp $WBT_PATH/WhiteboxTools_linux_amd64/WBT/whitebox_tools $WBT_PATH
# FORCE DOWNLOAD ONCE: This detects your /usr/local/... path and bakes it into the image layer
# RUN python -c "import whitebox; whitebox.download_wbt(reset=True)"
# ENV WBT_PATH=/usr/local/lib/python3.12/dist-packages/whitebox/WBT/whitebox_tools
ENV WBT_EXE_PATH=/usr/local/lib/python3.12/dist-packages/whitebox/WBT/whitebox_tools
# FORCE DOWNLOAD ONCE: This detects your /usr/local/... path and bakes it into the image layer
RUN python -c "import whitebox; whitebox.download_wbt(reset=True)"


RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    && echo "Stage 2: Finalization: $(date)"
# Expose port 8899 in case you want to launch Jupyter or JupyterLab from inside the container
EXPOSE 8899

COPY ./system_optimization.sh /
COPY ./entrypoint.sh /
RUN chmod +x /entrypoint.sh && chmod +x /system_optimization.sh
ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]

# CMD ["/bin/bash"]

RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    && echo "Stage 2: Complete: $(date)" \
    && echo "++++++++++++++++++++++++++++++++++++++++++++++"
