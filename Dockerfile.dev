RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    echo "Stage 2: Finalizing stage: $(date)"

# Create the symlink to fix the pre-compiled binary for Taudem which is built on older GDAL versions
# RUN ln -s /usr/lib/x86_64-linux-gnu/libgdal.so.38 /usr/lib/x86_64-linux-gnu/libgdal.so.34 && ldconfig


ADD ./src/entrypoint.sh /
ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]

# Set Bash as the fallback command. Since you run in interactive mode (-it),
# if your entrypoint exits or is overridden, you are cleanly dropped into the shell.
CMD ["/bin/bash"]

RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    echo "Stage 2: Complete: $(date)" \
    echo "++++++++++++++++++++++++++++++++++++++++++++++"

