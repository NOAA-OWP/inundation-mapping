# Docker will check your local machine for this image first
# TEMP test, using the local taudem image I created earlier
FROM taudem_build_image_3:latest AS taudem_builder

FROM ghcr.io/osgeo/gdal:ubuntu-small-3.12.3

# 1. Global System Locales, Timezone, and Non-interactive Configurations
ENV LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    DEBIAN_FRONTEND=noninteractive \
    TZ=UTC
    
# 2. Setup Build Arguments and Sequential Environment Paths
ARG DATA_DIR=/data
ARG DEP_DIR=/dependencies

ENV projectDir=/foss_fim
ENV inputsDir=$DATA_DIR/inputs \
    outputsDir=/outputs \
    srcDir=$projectDir/src \
    toolsDir=$projectDir/tools \
    workDir=/fim_temp

#   FIXED PATHS: Point to /usr/local/share/proj instead of /usr/share/proj
ENV GDAL_VERSION=3.12.3 \
    GDAL_CONFIG=/usr/bin/gdal-config \
    PROJ_DIR=/usr/local/share/proj \
    PROJ_LIB=/usr/local/share/proj \
    PYPROJ_GLOBAL_CONTEXT=ON \
    C_INCLUDE_PATH=/usr/include/gdal \
    CPLUS_INCLUDE_PATH=/usr/include/gdal


# UV Optimizations for global system Python and faster container startup
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_SYSTEM_PYTHON=1 \
    UV_BREAK_SYSTEM_PACKAGES=1

# Set system environment variables to prevent Python issues inside Docker
# Also supress all FutureWarnings. We can wait until they become Warnings.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONWARNINGS="ignore::FutureWarning"

# Set other env variables
ENV PATH="${projectDir}:${DEP_DIR}:${PATH}"

# This helps with permissions when writing to drives.
ARG GroupID=1370800235
ARG GroupName=fim
RUN groupadd --gid $GroupID $GroupName
ENV GID=$GroupID
ENV GN=$GroupName

## ============================
# Copy TauDEM binaries into image
ARG TAUDEM_BIN_SRC_DIR=/TauDEM_builder/bin
ENV taudemDir=$DEP_DIR/TauDEM/bin
COPY --from=taudem_builder $TAUDEM_BIN_SRC_DIR $taudemDir
RUN chmod -R 777 $DEP_DIR

## ============================
# Grab the official 'uv' binary using a multi-stage copy
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# ==============================================================================
RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    && echo "Stage 2: Apt downloads and setup: $(date)"

# System Packages, Runtime Utilities, and C++ Compilers (Must be before uv installs)
RUN apt-get update && apt-get install -y --no-install-recommends \
    # --- Permanent Runtime Utilities ---
    curl \
    time \
    parallel \
    p7zip-full \
    unzip \
    git \
    rsync \
    tzdata \
    wget \
    osmium-tool \
    ca-certificates \
    python3-gdal \
    mpich \
    openmpi-bin \
    # --- Temporary Python/Geospatial Build Tools needed in this script ---
    build-essential \
    python3-dev \
    python3-venv \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*


RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    && echo "Stage 2: Copy Pipfile and install packages: $(date)"

COPY ./constraints.txt constraints.txt 
ENV UV_CONSTRAINT="constraints.txt"

# COPY ./requirements_v9_rebuild_20261019.txt requirements.txt

# Step 4: Core Geospatial Stack Compilation Phase
# We explicitly force the correct compilation settings for the baseline libraries
# RUN uv pip install --system --no-cache "numpy>=2.0.0" \
#     && uv pip install --system --no-cache --no-build-isolation "gdal[numpy]==$(gdal-config --version).*" "pyogrio" \
#     && uv pip install --system --no-cache --no-binary fiona --no-binary rasterio "fiona" "rasterio"

# # Step 4: Core Geospatial Stack Compilation Phase
# We explicitly install setuptools and wheel first so the GDAL build backend has them available,
# then we compile the core stack against NumPy 2.x.
RUN uv pip install --system --no-cache \
     "numpy>=2.0.0" "setuptools" "wheel" && \
    uv pip install --system --no-cache \
    --no-build-isolation \
     "gdal[numpy]==$(gdal-config --version).*" "pyogrio" && \
    uv pip install --system --no-cache \
    --no-binary fiona \
    --no-binary rasterio "fiona" "rasterio"

    
# Bulk Requirements Installation Phase
# We enforce that NumPy 2.x and GDAL 3.12 are locked, then install everything else
# RUN echo "numpy>=2.0.0\ngdal==$(gdal-config --version).*\nrasterio\nfiona\npyogrio" > /tmp/geospatial_constraints.txt 

COPY ./requirements_v10b.txt requirements.txt

RUN uv pip install --system --no-cache \
    -c constraints.txt \
    -r requirements.txt

# RUN  uv pip compile requirements-min.ini -o requirements_v8_rebuild_20261019.txt
# Get a uv pip freeze and see what we have for versions.


## ******

## ADD GDAL Optimizations



