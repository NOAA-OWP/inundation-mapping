# Base Image that has GDAL, PROJ, etc

RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    echo "Stage 3: Starting Stage 3 main build: $(date)"

FROM ubuntu:24.04

ARG dataDir=/data
ARG depDir=/dependencies

ENV projectDir=/foss_fim
ENV inputsDir=$dataDir/inputs
ENV outputsDir=/outputs
ENV srcDir=$projectDir/src
ENV toolsDir=$projectDir/tools
ENV workDir=/fim_temp
ENV taudemDir=$depDir/taudem/bin
ENV taudemDir2=$depDir/taudem_accelerated_flowDirections/taudem/build/bin

ENV LC_ALL=C.UTF-8 \
    LANG=C.UTF-8 \
    DEBIAN_FRONTEND=noninteractive \
    TZ=UTC

ENV UV_SYSTEM_PYTHON=1
ENV UV_BREAK_SYSTEM_PACKAGES=1

# --- Global Geospatial Performance Tuning ---
# Keep these active for your single-file performance
# Safe per-process baselines for heavy GNU Parallel or Multiprocessing tasks
ENV GDAL_CACHEMAX=1024
ENV OGR_SQLITE_CACHE=512
ENV OGR_SQLITE_SYNCHRONOUS=OFF
# Reduce GDAL thread competition when Python handles the parallelization
ENV GDAL_NUM_THREADS=1

# Copy the compiled TauDEM files from the first stage
# COPY --from=gdal_builder $depDir $depDir
# RUN chown -R root:root $depDir && chmod -R 777 $depDir

# --- Global Configurations ---
ENV PATH="${projectDir}:${PATH}"
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

## ADD TO PYTHON PATHS ##
ENV PYTHONPATH="${projectDir}:\
${srcDir}:\
${srcDir}/utils:\
${projectDir}/data:\
${toolsDir}"

## ============================
## Create working directories
#RUN mkdir -p $workDir

# TODO: Oct 2026: This should be updated, but it is fine for now
## ADDING FIM GROUP ##
ARG GroupID=1370800235
ARG GroupName=fim
RUN groupadd --gid $GroupID $GroupName
ENV GID=$GroupID
ENV GN=$GroupName


RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    echo "Stage 3: Apt downloads and setup: $(date)"


# Set up general, static Linux utilities (Cached permanently)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    time parallel \
    htop acl \
    p7zip-full unzip git \
    rsync tzdata wget osmium-tool \
    && apt-get clean \    
    && rm -rf /var/lib/apt/lists/*

# Install runtime dependencies focusing on gdal (must match gdal_builder dependencies closely)
# Core C runtime dependencies for Python & Spatial engines (Cached permanently)
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    libproj-dev \
    libgeos-dev \
    libsqlite3-dev \
    libtiff-dev \
    libcurl4-openssl-dev \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies required to compile GDAL 3.12
# RUN apt-get update && apt-get install -y --no-install-recommends \
#     build-essential \
#     cmake \
#     python3-dev \
#     python3-setuptools \
#     curl \
#     ca-certificates \
#     # Required core geospatial dependencies
#     libproj-dev \
#     libgeos-dev \
#     libsqlite3-dev \
#     libtiff-dev \
#     libcurl4-openssl-dev \
#     pkg-config \
#     && rm -rf /var/lib/apt/lists/*

# 2. Tell the compiler where the new GDAL 3.12 headers are
# ENV CPLUS_INCLUDE_PATH=/usr/include/gdal
# ENV C_INCLUDE_PATH=/usr/include/gdal

# Copy the compiled GDAL 3.12 binaries from the gdal_builder stage
COPY --from=gdal_builder /usr/local /usr/local
RUN ldconfig

# Set critical compiler pathing flags pointing to our freshly baked 3.12 headers
# Explicit compiler and linker paths targeting your custom GDAL 3.12 location
ENV CPLUS_INCLUDE_PATH=/usr/local/include
ENV C_INCLUDE_PATH=/usr/local/include
ENV LD_LIBRARY_PATH=/usr/local/lib:/usr/lib:/lib

# Pull down the high-speed uv package manager binary.
# uv is a powerful pip installer that is very quick and very good
# at managing dependencies and its relationship to the entire docker image.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Dynamically generate the global constraints rule file
RUN echo "numpy>=2.0.0" > /constraints.txt && \
    echo "GDAL==3.12.0" >> /constraints.txt

# THIS is where they actually get downloaded, compiled, and installed!
# Explicitly compile the core C-extensions against the custom GDAL/NumPy stack
#    uv reads the text file via "-c" and forces the installation to match your rules.
# This has been optimized for geoparquet
RUN uv pip install -c /constraints.txt \
    --no-binary pyogrio \
    --no-binary rasterio \
    --no-binary fiona \
    --no-binary shapely \
    pyogrio rasterio fiona shapely \
    # Add pyarrow here so your container natively supports GeoParquet workflows
    pyarrow



