###############################################################################################
# Base Image that has GDAL, PROJ, etc
# We explicitly are not using the osgeo gdal 3:12 builder as it has some precompiled
# other critically dependant, also compiled inside of it, and force numpy<2.0.
# We want numpy higher than 2.0. So, we manually add our own stage that
# builds GDAL the way we want and we pass that to the third and main builder stage
RUN echo "++++++++++++++++++++++++++++++++++++++++++++++" \
    echo "Stage 2: Starting Stage 2 GDAL and PROJ build: $(date)"

# Stage 1: Build GDAL 3.12 binaries from source
FROM ubuntu:24.04 AS gdal_builder

ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies required to compile GDAL 3.12
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    python3-dev \
    python3-setuptools \
    curl \
    ca-certificates \
    # Required core geospatial dependencies
    libproj-dev \
    libgeos-dev \
    libsqlite3-dev \
    libtiff-dev \
    libcurl4-openssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# Download and compile GDAL 3.12.0 explicitly
WORKDIR /src
RUN curl -L https://github.com | tar -xz && \
    mkdir gdal-3.12.0/build && \
    cd gdal-3.12.0/build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DBUILD_PYTHON_BINDINGS=OFF && \
    cmake --build . -j$(nproc) && \
    cmake --install .

# Copy the compiled TauDEM files from the first stage
# ARG depDir=/dependencies
# ENV taudemDir=$depDir/taudem/bin
# ENV taudemDir2=$depDir/taudem_accelerated_flowDirections/taudem/build/bin
# COPY --from=taudem_builder $depDir $depDir
# RUN chown -R root:root $depDir && chmod -R 777 $depDir

# Download, extract, compile, and install GDAL 3.12.0 via the official OSGeo mirror
# WORKDIR /src
# RUN curl -L http://osgeo.org | tar -xz && \
#     mkdir gdal-3.12.0/build && \
#     cd gdal-3.12.0/build && \
#     cmake .. \
#         -DCMAKE_BUILD_TYPE=Release \
#         -DCMAKE_INSTALL_PREFIX=/usr/local \
#         -DBUILD_PYTHON_BINDINGS=OFF && \
#     cmake --build . -j$(nproc) && \
#     cmake --install .


